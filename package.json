{
  "name": "doors-guides",
  "version": "1.0.0",
  "description": "Чёрно-белый справочник по Roblox DOORS.",
  "author": "Tw1Zzy223",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "pnpm run build && electron electron/main.cjs",
    "desktop:pack": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "android:sync": "pnpm run build && cap sync android",
    "android:apk": "pnpm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": { "@capacitor/core": "^7.4.3" },
  "devDependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/cli": "^7.4.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7"
  },
  "build": {
    "appId": "ru.tw1zzy.doorsguides",
    "productName": "Doors Guides",
    "artifactName": "Doors-Guides-Setup-${version}.${ext}",
    "directories": { "output": "release-windows" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "installerLanguages": ["ru_RU"] }
  }
}
